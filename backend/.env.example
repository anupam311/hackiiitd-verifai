# Copy to backend/.env (run uvicorn from the backend/ folder). Never commit .env.
# Full variable reference: docs/deployment.md

VERIFAI_ENV=development
VERIFAI_LOG_LEVEL=INFO
VERIFAI_DATABASE_URL=sqlite:///./verifai.db

# --- URLs (must agree with each other and with the OAuth consoles) ---------------------------------
# Browser origin(s) of the frontend, exact match, no trailing slash.
VERIFAI_CORS_ORIGINS=http://localhost:3000
# Where THIS API is reachable from the browser. It builds the OAuth redirect URIs:
#   Google : <VERIFAI_PUBLIC_BASE_URL>/auth/google/callback  -> http://localhost:8000/auth/google/callback
#   GitHub : <VERIFAI_PUBLIC_BASE_URL>/auth/github/callback  -> http://localhost:8000/auth/github/callback
VERIFAI_PUBLIC_BASE_URL=http://localhost:8000
# Where users land after sign-in.
VERIFAI_FRONTEND_URL=http://localhost:3000
VERIFAI_SESSION_TTL_DAYS=7
# Sessions are random tokens stored (hashed) in the database; this value is reserved for deployments.
VERIFAI_SESSION_SECRET=change-me-to-a-long-random-string

# Production security (leave empty to disable in development)
VERIFAI_TRUSTED_HOSTS=
VERIFAI_MAX_REQUEST_BODY_BYTES=1048576

# --- Google sign-in -------------------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application)
#   Authorized JavaScript origin : http://localhost:3000
#   Authorized redirect URI      : http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- GitHub sign-in -------------------------------------------------------------------------------
# GitHub > Settings > Developer settings > OAuth Apps
#   Homepage URL                 : http://localhost:3000
#   Authorization callback URL   : http://localhost:8000/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- TinyFish live discovery (https://agent.tinyfish.ai/api-keys) ---------------------------------
# Needs `pip install tinyfish` (Python 3.11+). Discovery ALSO needs OPENAI_API_KEY + OPENAI_MODEL,
# because extracted listings are validated by the LLM extraction step.
TINYFISH_API_KEY=
# Optional tuning. Search is free; each agent run (one per page) costs credits.
VERIFAI_TINYFISH_MAX_PAGES=5
VERIFAI_TINYFISH_MAX_CONCURRENCY=3
VERIFAI_TINYFISH_AGENT_TIMEOUT_S=240
VERIFAI_TINYFISH_STEALTH=false
# Comma-separated careers pages that are always scanned in addition to search results.
VERIFAI_TINYFISH_SEED_PAGES=

# --- OpenAI (extraction) --------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=
