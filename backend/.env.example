# Copy to backend/.env. Never commit .env.
VERIFAI_ENV=development
VERIFAI_LOG_LEVEL=INFO
VERIFAI_CORS_ORIGINS=http://localhost:3000
VERIFAI_DATABASE_URL=sqlite:///./verifai.db
VERIFAI_SESSION_SECRET=change-me

# Provider credentials (server-side only; unused until the matching commit)
TINYFISH_API_KEY=
OPENAI_MODEL=
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=