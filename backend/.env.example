# Copy to backend/.env. Never commit .env.
# See docs/deployment.md for the full variable reference.

VERIFAI_ENV=development
VERIFAI_LOG_LEVEL=INFO
VERIFAI_CORS_ORIGINS=http://localhost:3000
VERIFAI_DATABASE_URL=sqlite:///./verifai.db
VERIFAI_PUBLIC_BASE_URL=http://localhost:8000
VERIFAI_FRONTEND_URL=http://localhost:3000
VERIFAI_SESSION_SECRET=change-me-to-a-long-random-string

# Production security (leave empty to disable in development)
VERIFAI_TRUSTED_HOSTS=
VERIFAI_MAX_REQUEST_BODY_BYTES=1048576

# Provider credentials (server-side only; unused until the matching commit)
TINYFISH_API_KEY=
OPENAI_MODEL=
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=